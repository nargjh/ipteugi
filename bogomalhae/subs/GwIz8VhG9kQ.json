{"id": "GwIz8VhG9kQ", "title": "5-Minute English Conversation Practice: Taxi Conversation", "channel": "English Together", "duration": 144, "auto": false, "lines": [{"i": 0, "s": 11.6, "e": 12.68, "en": "Hello!", "ko": "안녕하세요!"}, {"i": 1, "s": 12.68, "e": 16.2, "en": "Can you take me to Sunshine Hotel, please?", "ko": "선샤인 호텔까지 태워주시겠어요?"}, {"i": 2, "s": 16.2, "e": 19.15, "en": "Sure. Do you have luggage?", "ko": "물론이죠. 짐 있으신가요?"}, {"i": 3, "s": 19.15, "e": 21.64, "en": "Yes, I have a big bag.", "ko": "네, 큰 가방이 있어요."}, {"i": 4, "s": 21.64, "e": 25.1, "en": "Do you want me to put it in the trunk?", "ko": "트렁크에 넣어드릴까요?"}, {"i": 5, "s": 25.1, "e": 28.62, "en": "Yes, please. Thank you.", "ko": "네, 부탁드려요. 감사합니다."}, {"i": 6, "s": 28.62, "e": 29.84, "en": "No problem.", "ko": "문제없습니다."}, {"i": 7, "s": 29.84, "e": 32.46, "en": "Please get in the taxi.", "ko": "택시를 타세요."}, {"i": 8, "s": 32.65, "e": 36.17, "en": "You want to go to Sunshine Hotel, right?", "ko": "선샤인 호텔에 가시려는 거죠?"}, {"i": 9, "s": 36.17, "e": 37.58, "en": "Yes!", "ko": "네!"}, {"i": 10, "s": 37.58, "e": 41.29, "en": "OK.Please fasten your seatbelt.", "ko": "알겠습니다. 안전벨트를 매세요."}, {"i": 11, "s": 41.29, "e": 43.15, "en": "OK.", "ko": "알겠습니다."}, {"i": 12, "s": 43.15, "e": 46.48, "en": "Good. We will go now.", "ko": "좋습니다. 지금 가겠습니다."}, {"i": 13, "s": 51.91, "e": 55.18, "en": "We are at Sunshine Hotel now.", "ko": "지금 선샤인 호텔에 있습니다."}, {"i": 14, "s": 55.18, "e": 59.02, "en": "Thank you. How much do I pay?", "ko": "감사합니다. 얼마 내야 하나요?"}, {"i": 15, "s": 59.02, "e": 61.77, "en": "It is ten dollars, please.", "ko": "10달러입니다."}, {"i": 16, "s": 61.77, "e": 64.59, "en": "Here is ten dollars.", "ko": "여기 10달러입니다."}, {"i": 17, "s": 64.59, "e": 67.08, "en": "Thank you very much!", "ko": "정말 감사합니다!"}, {"i": 18, "s": 71.87, "e": 72.45, "en": "Hello!", "ko": "안녕하세요!"}, {"i": 19, "s": 72.45, "e": 75.97, "en": "Can you take me to the train station, please?", "ko": "기차역까지 태워주시겠어요?"}, {"i": 20, "s": 76.03, "e": 77.18, "en": "Sure.", "ko": "물론이죠."}, {"i": 21, "s": 77.4, "e": 79.51, "en": "I'm in a hurry.", "ko": "급한데"}, {"i": 22, "s": 79.51, "e": 82.84, "en": "My train leaves soon.", "ko": "기차가 곧 출발합니다."}, {"i": 23, "s": 82.84, "e": 86.17, "en": "Ok, I will drive fast.", "ko": "알겠습니다. 빨리 운전하겠습니다."}, {"i": 24, "s": 90.39, "e": 94.36, "en": "There is a faster road to the train station.", "ko": "기차역까지 가는 더 빠른 길이 있습니다."}, {"i": 25, "s": 94.36, "e": 96.22, "en": "Oh, really?", "ko": "아, 정말요?"}, {"i": 26, "s": 96.28, "e": 98.58, "en": "Please take that road.", "ko": "그 길로 가세요."}, {"i": 27, "s": 98.58, "e": 101.91, "en": "OK. It will save time.", "ko": "알겠습니다. 시간이 절약될 겁니다."}, {"i": 28, "s": 106.08, "e": 108.83, "en": "We are near the train station now.", "ko": "지금 기차역 근처에 있습니다."}, {"i": 29, "s": 108.96, "e": 111.07, "en": "How much do I pay?", "ko": "얼마 내야 하나요?"}, {"i": 30, "s": 111.2, "e": 114.27, "en": "It is fifteen dollars, please.", "ko": "15달러입니다."}, {"i": 31, "s": 114.4, "e": 117.22, "en": "Thank you for driving fast.", "ko": "빨리 운전해주셔서 감사합니다."}, {"i": 32, "s": 117.28, "e": 119.01, "en": "You’re welcome.", "ko": "천만에요."}]}