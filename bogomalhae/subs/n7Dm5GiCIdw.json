{"ko_src": "claude", "id": "n7Dm5GiCIdw", "title": "English at Immigration 🛂 | Real Airport Conversation for Beginners", "channel": "RealChatEnglish", "duration": 53, "auto": true, "lines": [{"i": 0, "s": 0, "e": 2.55, "en": "Next, please. Good afternoon.", "ko": "다음 분, 오세요. 안녕하세요."}, {"i": 1, "s": 2.67, "e": 4.2, "en": "May I see your passport?", "ko": "여권 좀 보여 주시겠어요?"}, {"i": 2, "s": 4.15, "e": 6.09, "en": "Hello. Yes, here it is.", "ko": "안녕하세요. 네, 여기요."}, {"i": 3, "s": 8.03, "e": 10.03, "en": "What is the purpose of your visit?", "ko": "방문 목적이 무엇인가요?"}, {"i": 4, "s": 10.31, "e": 12.11, "en": "I am here for tourism.", "ko": "관광하러 왔어요."}, {"i": 5, "s": 12.35, "e": 13.85, "en": "How long will you stay?", "ko": "얼마나 머무르실 건가요?"}, {"i": 6, "s": 14.07, "e": 15.85, "en": "I will stay for 1 week.", "ko": "일주일 머물 거예요."}, {"i": 7, "s": 16.19, "e": 17.49, "en": "Where will you stay?", "ko": "어디서 지내실 건가요?"}, {"i": 8, "s": 17.63, "e": 19.21, "en": "At a hotel downtown.", "ko": "시내 호텔이요."}, {"i": 9, "s": 19.51, "e": 21.21, "en": "At a hotel downtown.", "ko": "시내 호텔이요."}, {"i": 10, "s": 21.47, "e": 22.92, "en": "Do you have a return ticket?", "ko": "돌아가는 항공권은 있으세요?"}, {"i": 11, "s": 22.87, "e": 23.93, "en": "Yes, I do.", "ko": "네, 있어요."}, {"i": 12, "s": 24.15, "e": 25.6, "en": "Are you carrying any restricted", "ko": "반입이 제한된 물건을 가지고"}, {"i": 13, "s": 25.55, "e": 26.85, "en": "items? No,", "ko": "계신가요? 아니요,"}, {"i": 14, "s": 27.07, "e": 27.95, "en": "I am not.", "ko": "없어요."}, {"i": 15, "s": 28.19, "e": 29.96, "en": "Did you pack your bags yourself?", "ko": "짐은 직접 싸셨나요?"}, {"i": 16, "s": 29.91, "e": 31.89, "en": "Yes, I packed them myself.", "ko": "네, 제가 직접 쌌어요."}, {"i": 17, "s": 31.95, "e": 33.8, "en": "May I see your boarding pass, please?", "ko": "탑승권도 보여 주시겠어요?"}, {"i": 18, "s": 33.75, "e": 35.13, "en": ">> Okay. Of course.", "ko": "네. 물론이죠."}, {"i": 19, "s": 35.39, "e": 36.96, "en": "Thank you. You may proceed.", "ko": "감사합니다. 들어가셔도 됩니다."}, {"i": 20, "s": 36.91, "e": 38.09, "en": "Thank you very much.", "ko": "정말 감사합니다."}, {"i": 21, "s": 40.75, "e": 41.63, "en": "Welcome.", "ko": "천만에요."}, {"i": 22, "s": 41.83, "e": 43.09, "en": "Enjoy your stay.", "ko": "즐거운 시간 보내세요."}, {"i": 23, "s": 43.51, "e": 45.55, "en": "Thank you. Have a nice day.", "ko": "감사합니다. 좋은 하루 되세요."}]}