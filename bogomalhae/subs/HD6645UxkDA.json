{"id": "HD6645UxkDA", "title": "5-Minute English Conversation Practice: Checking Into a Hotel", "channel": "English Together", "duration": 154, "auto": false, "lines": [{"i": 0, "s": 11.8, "e": 13.53, "en": "Good afternoon!", "ko": "좋은 오후에요!"}, {"i": 1, "s": 13.6, "e": 16.16, "en": "Welcome to City Hotel.", "ko": "시티 호텔에 오신 것을 환영합니다."}, {"i": 2, "s": 16.16, "e": 18.59, "en": "How can I help you?", "ko": "어떻게 도와드릴까요?"}, {"i": 3, "s": 18.78, "e": 21.91, "en": "Hello! I have a reservation.", "ko": "안녕하세요! 예약이 있어요."}, {"i": 4, "s": 22.11, "e": 25.43, "en": "Great! What is your name, please?", "ko": "엄청난! 당신의 이름은 무엇입니까?"}, {"i": 5, "s": 25.63, "e": 28.89, "en": "My name is John Smith.", "ko": "제 이름은 존 스미스입니다."}, {"i": 6, "s": 29.02, "e": 31.39, "en": "Thank you, Mr. Smith.", "ko": "고마워요, 스미스 씨."}, {"i": 7, "s": 31.39, "e": 34.27, "en": "Let me check your reservation.", "ko": "예약 내용을 확인해 보겠습니다."}, {"i": 8, "s": 36.06, "e": 39.0, "en": "Yes, I see your reservation.", "ko": "네, 예약하신 내용을 확인했습니다."}, {"i": 9, "s": 39.0, "e": 42.2, "en": "You are staying for three nights, right?", "ko": "3박 묵으시는 거 맞죠?"}, {"i": 10, "s": 42.46, "e": 44.76, "en": "Yes, that’s correct.", "ko": "네, 맞습니다."}, {"i": 11, "s": 45.15, "e": 48.45, "en": "Perfect! Can I have your ID, please?", "ko": "완벽한! 신분증 좀 주시겠어요?"}, {"i": 12, "s": 49.62, "e": 51.99, "en": "Sure, here it is.", "ko": "물론이죠. 여기 있습니다."}, {"i": 13, "s": 52.38, "e": 53.85, "en": "Thank you.", "ko": "감사합니다."}, {"i": 14, "s": 53.85, "e": 56.86, "en": "Do you have a credit card for the payment?", "ko": "결제에 신용카드가 있나요?"}, {"i": 15, "s": 57.12, "e": 60.64, "en": "Yes, I do. Here it is.", "ko": "네, 그렇습니다. 여기 있습니다."}, {"i": 16, "s": 61.02, "e": 62.62, "en": "Thank you!", "ko": "감사합니다!"}, {"i": 17, "s": 62.62, "e": 64.92, "en": "Your room is ready.", "ko": "귀하의 방이 준비되었습니다."}, {"i": 18, "s": 65.18, "e": 68.44, "en": "It is room 205.", "ko": "205호실입니다."}, {"i": 19, "s": 69.53, "e": 70.94, "en": "Thank you!", "ko": "감사합니다!"}, {"i": 20, "s": 70.94, "e": 73.31, "en": "Which floor is that on?", "ko": "그거 몇층에 있어요?"}, {"i": 21, "s": 73.63, "e": 76.19, "en": "It is on the second floor.", "ko": "2층에 있습니다."}, {"i": 22, "s": 76.38, "e": 79.52, "en": "You can take the elevator over there.", "ko": "저기서 엘리베이터를 타시면 됩니다."}, {"i": 23, "s": 80.16, "e": 82.11, "en": "Okay, thank you.", "ko": "알겠습니다. 감사합니다."}, {"i": 24, "s": 82.11, "e": 85.66, "en": "By the way, does the hotel have Wi-Fi?", "ko": "그런데 호텔에 Wi-Fi가 있나요?"}, {"i": 25, "s": 86.11, "e": 88.16, "en": "Yes, we do!", "ko": "네, 그렇습니다!"}, {"i": 26, "s": 88.16, "e": 90.72, "en": "The Wi-Fi is free.", "ko": "Wi-Fi는 무료입니다."}, {"i": 27, "s": 90.84, "e": 94.56, "en": "You can find the username and password in your room.", "ko": "귀하의 방에서 사용자 이름과 비밀번호를 찾을 수 있습니다."}, {"i": 28, "s": 94.56, "e": 96.73, "en": "It’s on the desk.", "ko": "책상 위에 있어요."}, {"i": 29, "s": 96.99, "e": 99.1, "en": "That’s good to know.", "ko": "알아두면 좋습니다."}, {"i": 30, "s": 99.36, "e": 104.48, "en": "Also, check-out time is by 11:00 AM on your last day.", "ko": "또한, 체크아웃 시간은 마지막 날 오전 11시까지 입니다."}, {"i": 31, "s": 104.47, "e": 108.44, "en": "Okay, 11:00 AM. Got it.", "ko": "알겠습니다. 오전 11시입니다. 알았어요."}, {"i": 32, "s": 108.57, "e": 111.19, "en": "Here is your key card.", "ko": "여기 키 카드가 있습니다."}, {"i": 33, "s": 112.47, "e": 114.84, "en": "Thank you very much.", "ko": "매우 감사합니다."}, {"i": 34, "s": 115.16, "e": 117.27, "en": "Enjoy your stay!", "ko": "즐거운 시간 보내세요!"}, {"i": 35, "s": 117.47, "e": 120.73, "en": "If you need anything, just call the front desk.", "ko": "필요한 것이 있으면 프런트 데스크에 전화하세요."}, {"i": 36, "s": 120.92, "e": 124.38, "en": "I will. Thanks again!", "ko": "그럴게요. 다시 한 번 감사드립니다!"}, {"i": 37, "s": 124.38, "e": 126.56, "en": "Have a nice day!", "ko": "좋은 하루 되세요!"}]}