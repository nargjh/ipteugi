{"id": "TYWSOrBHqmU", "title": "5-Minute English for Travel: Asking for Directions on the Train & Small Talk", "channel": "English Together", "duration": 143, "auto": false, "lines": [{"i": 0, "s": 11.97, "e": 14.46, "en": "Excuse me, hello.", "ko": "실례합니다, 안녕하세요."}, {"i": 1, "s": 14.53, "e": 17.79, "en": "I want to see the big castle.", "ko": "큰 성을 보고 싶습니다."}, {"i": 2, "s": 17.79, "e": 21.18, "en": "Can you tell me which station I should get off?", "ko": "어느 역에서 내려야 할지 알려주시겠어요?"}, {"i": 3, "s": 21.18, "e": 22.98, "en": "Of course!", "ko": "물론입니다!"}, {"i": 4, "s": 23.87, "e": 27.97, "en": "Are you talking about Silver Hill Castle?", "ko": "실버 힐 성을 말씀하시는 건가요?"}, {"i": 5, "s": 28.54, "e": 31.23, "en": "Yes, that’s the one!", "ko": "네, 바로 그 성이요!"}, {"i": 6, "s": 31.42, "e": 34.94, "en": "Then you should get off at Green Park Station.", "ko": "그린 파크 역에서 내리시면 됩니다."}, {"i": 7, "s": 34.94, "e": 38.14, "en": "After that, you walk for ten minutes.", "ko": "그 후 10분 정도 걸으면 됩니다."}, {"i": 8, "s": 38.14, "e": 41.09, "en": "It’s very easy to find.", "ko": "찾기 아주 쉽습니다."}, {"i": 9, "s": 41.15, "e": 42.88, "en": "Thank you very much!", "ko": "정말 감사합니다!"}, {"i": 10, "s": 42.88, "e": 44.86, "en": "Green Park Station.", "ko": "그린 파크 역입니다."}, {"i": 11, "s": 44.86, "e": 46.66, "en": "I understand.", "ko": "알겠습니다."}, {"i": 12, "s": 46.66, "e": 48.64, "en": "You’re welcome.", "ko": "천만에요."}, {"i": 13, "s": 53.31, "e": 56.06, "en": "Are you visiting our city?", "ko": "저희 도시를 방문하시나요?"}, {"i": 14, "s": 56.06, "e": 57.28, "en": "Yes, I am.", "ko": "네, 그렇습니다."}, {"i": 15, "s": 57.28, "e": 58.75, "en": "I’m on holiday.", "ko": "휴가 중이에요."}, {"i": 16, "s": 58.75, "e": 61.25, "en": "Oh, that’s nice!", "ko": "오, 반갑네요!"}, {"i": 17, "s": 61.25, "e": 63.49, "en": "Where are you from?", "ko": "어디 출신이세요?"}, {"i": 18, "s": 63.49, "e": 65.79, "en": "I’m from New York.", "ko": "저는 뉴욕 출신입니다."}, {"i": 19, "s": 65.79, "e": 67.26, "en": "New York!", "ko": "뉴욕!"}, {"i": 20, "s": 67.26, "e": 69.7, "en": "Wow, that’s far.", "ko": "와, 멀네요."}, {"i": 21, "s": 69.7, "e": 72.19, "en": "Is this your first time here?", "ko": "여기 처음 오셨나요?"}, {"i": 22, "s": 72.19, "e": 74.18, "en": "Yes, my first time.", "ko": "네, 저는 처음 옵니다."}, {"i": 23, "s": 74.18, "e": 75.9, "en": "My name is Tom.", "ko": "제 이름은 톰입니다."}, {"i": 24, "s": 75.9, "e": 79.68, "en": "I always wanted to see the castle and the old town.", "ko": "성과 구시가지를 항상 보고 싶었어요."}, {"i": 25, "s": 79.68, "e": 81.6, "en": "Nice to meet you, Tom.", "ko": "만나서 반갑습니다, 톰."}, {"i": 26, "s": 81.6, "e": 84.03, "en": "My name is Angela.", "ko": "제 이름은 안젤라입니다."}, {"i": 27, "s": 84.03, "e": 85.89, "en": "Nice to meet you, Angela.", "ko": "만나서 반갑습니다, 안젤라."}, {"i": 28, "s": 85.89, "e": 88.0, "en": "Do you live near here?", "ko": "이 근처에 사시나요?"}, {"i": 29, "s": 88.26, "e": 91.01, "en": "Yes, I live two stops away.", "ko": "네, 두 정거장 거리에 사는데요."}, {"i": 30, "s": 91.84, "e": 92.86, "en": "I see.", "ko": "알겠습니다."}, {"i": 31, "s": 92.86, "e": 95.23, "en": "Your city is very beautiful.", "ko": "도시가 정말 아름답습니다."}, {"i": 32, "s": 95.23, "e": 97.66, "en": "The people are friendly.", "ko": "사람들도 친절합니다."}, {"i": 33, "s": 97.79, "e": 98.88, "en": "Thank you!", "ko": "감사합니다!"}, {"i": 34, "s": 98.88, "e": 101.57, "en": "I hope you enjoy your visit.", "ko": "즐거운 방문 되시길 바랍니다."}, {"i": 35, "s": 101.57, "e": 105.47, "en": "Don’t forget to try our local cake near the castle.", "ko": "성 근처에 있는 저희 지역 케이크도 꼭 드셔보세요."}, {"i": 36, "s": 105.66, "e": 107.65, "en": "Oh, that sounds great.", "ko": "오, 정말 좋은 것 같아요."}, {"i": 37, "s": 107.65, "e": 109.7, "en": "I will try it.", "ko": "한번 해볼게요."}, {"i": 38, "s": 109.82, "e": 112.26, "en": "Thank you for your help, Angela.", "ko": "도와주셔서 감사합니다, 앤젤라."}, {"i": 39, "s": 112.26, "e": 114.11, "en": "You’re welcome, Tom.", "ko": "천만에요, 톰."}, {"i": 40, "s": 114.11, "e": 117.12, "en": "Have a good day and enjoy the castle!", "ko": "좋은 하루 보내시고 성에서 즐거운 시간 보내세요!"}]}