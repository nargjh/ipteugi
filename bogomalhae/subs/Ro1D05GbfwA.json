{"id": "Ro1D05GbfwA", "title": "5-Minute English Conversation Practice:  On The Plane (Travel English)", "channel": "English Together", "duration": 176, "auto": false, "lines": [{"i": 0, "s": 11.9, "e": 13.92, "en": "Welcome aboard!", "ko": "탑승을 환영합니다!"}, {"i": 1, "s": 13.92, "e": 16.51, "en": "Please find your seat.", "ko": "자리를 찾아주세요."}, {"i": 2, "s": 16.61, "e": 19.68, "en": "These are our seats.", "ko": "이게 우리 좌석이에요."}, {"i": 3, "s": 19.68, "e": 22.75, "en": "Yes, we are in row 12.", "ko": "네, 저희는 12열입니다."}, {"i": 4, "s": 23.78, "e": 27.1, "en": "Ladies and gentlemen, we will take off soon.", "ko": "신사숙녀 여러분, 곧 출발하겠습니다."}, {"i": 5, "s": 27.1, "e": 29.79, "en": "Please fasten your seatbelts.", "ko": "안전벨트를 매주세요."}, {"i": 6, "s": 30.43, "e": 33.31, "en": "I’m excited for this trip!", "ko": "이번 여행이 기대됩니다!"}, {"i": 7, "s": 33.31, "e": 34.78, "en": "Me too!", "ko": "저도요!"}, {"i": 8, "s": 34.78, "e": 37.6, "en": "Do you have your book?", "ko": "당신의 책을 가지고 있나요?"}, {"i": 9, "s": 37.6, "e": 40.54, "en": "Yes, I have it right here.", "ko": "네, 바로 여기에 있어요."}, {"i": 10, "s": 46.56, "e": 48.67, "en": "Look at the clouds!", "ko": "구름 좀 봐!"}, {"i": 11, "s": 48.67, "e": 51.49, "en": "They are so beautiful.", "ko": "그들은 너무 아름답습니다."}, {"i": 12, "s": 52.06, "e": 54.56, "en": "Yes! They are.", "ko": "예! 그렇습니다."}, {"i": 13, "s": 55.53, "e": 58.78, "en": "Hello! What would you like to drink?", "ko": "안녕하세요! 무엇을 마시고 싶나요?"}, {"i": 14, "s": 58.78, "e": 61.6, "en": "I would like orange juice, please.", "ko": "오렌지 주스 주세요."}, {"i": 15, "s": 62.88, "e": 64.93, "en": "Sure, here you are.", "ko": "물론이죠. 여기 있습니다."}, {"i": 16, "s": 64.93, "e": 66.53, "en": "Thank you.", "ko": "감사합니다."}, {"i": 17, "s": 66.85, "e": 69.34, "en": "What would you like to drink?", "ko": "무엇을 마시고 싶나요?"}, {"i": 18, "s": 69.34, "e": 72.03, "en": "I want a Coke, please.", "ko": "콜라 주세요."}, {"i": 19, "s": 72.03, "e": 74.09, "en": "Ice and lemon?", "ko": "얼음과 레몬?"}, {"i": 20, "s": 74.3, "e": 76.22, "en": "Just ice, please.", "ko": "얼음만 주세요."}, {"i": 21, "s": 77.4, "e": 78.97, "en": "Here you are.", "ko": "여기 있어요."}, {"i": 22, "s": 78.97, "e": 80.5, "en": "Thank you.", "ko": "감사합니다."}, {"i": 23, "s": 86.2, "e": 90.55, "en": "Ladies and gentlemen, we are serving lunch now.", "ko": "신사 숙녀 여러분, 우리는 지금 점심을 제공하고 있습니다."}, {"i": 24, "s": 90.55, "e": 93.56, "en": "Please wait a moment while we prepare.", "ko": "준비하는 동안 잠시만 기다려주세요."}, {"i": 25, "s": 93.56, "e": 96.82, "en": "I wonder what we will have for lunch.", "ko": "우리가 점심으로 무엇을 먹을지 궁금해요."}, {"i": 26, "s": 96.82, "e": 99.57, "en": "I hope it is good!", "ko": "나는 그것이 좋기를 바랍니다!"}, {"i": 27, "s": 100.47, "e": 102.71, "en": "Here is your lunch!", "ko": "여기 점심이 있습니다!"}, {"i": 28, "s": 102.71, "e": 106.23, "en": "Would you like the chicken or the fish?", "ko": "닭고기를 원하시나요, 아니면 생선을 원하시나요?"}, {"i": 29, "s": 106.23, "e": 109.11, "en": "I’ll have the fish, please.", "ko": "물고기 주세요."}, {"i": 30, "s": 109.11, "e": 111.29, "en": "I’ll take the chicken, please.", "ko": "치킨 주세요."}, {"i": 31, "s": 112.89, "e": 114.55, "en": "Sure, here you are.", "ko": "물론이죠. 여기 있습니다."}, {"i": 32, "s": 114.55, "e": 117.3, "en": "Enjoy your lunch!", "ko": "점심을 즐겨보세요!"}, {"i": 33, "s": 118.74, "e": 120.4, "en": "That was nice.", "ko": "그거 좋았어."}, {"i": 34, "s": 120.4, "e": 123.02, "en": "I feel full now.", "ko": "나는 지금 포만감을 느낀다."}, {"i": 35, "s": 123.03, "e": 126.74, "en": "Me too! Let’s rest for a bit.", "ko": "저도요! 잠시 쉬자."}, {"i": 36, "s": 133.71, "e": 137.68, "en": "Ladies and gentlemen, we are ready to land.", "ko": "신사숙녀 여러분, 이제 착륙할 준비가 되었습니다."}, {"i": 37, "s": 137.68, "e": 142.61, "en": "Please remain seated until we stop. Thank you!", "ko": "우리가 멈출 때까지 자리에 앉아 계십시오. 감사합니다!"}, {"i": 38, "s": 142.87, "e": 145.62, "en": "We are almost there!", "ko": "거의 다 왔어요!"}, {"i": 39, "s": 145.62, "e": 149.14, "en": "Yes, I can’t wait to see the city!", "ko": "네, 빨리 도시를 보고 싶어요!"}]}