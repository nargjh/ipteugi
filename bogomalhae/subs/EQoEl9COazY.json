{"id": "EQoEl9COazY", "title": "5-Minute English Conversation Practice: At the Restaurant (Ordering Food)", "channel": "English Together", "duration": 185, "auto": false, "lines": [{"i": 0, "s": 12.39, "e": 13.73, "en": "Good evening.", "ko": "안녕하세요."}, {"i": 1, "s": 13.73, "e": 15.52, "en": "Welcome to Blue Harbor.", "ko": "블루 하버에 오신 것을 환영합니다."}, {"i": 2, "s": 15.52, "e": 17.51, "en": "Do you have a reservation?", "ko": "예약하셨나요?"}, {"i": 3, "s": 17.76, "e": 20.26, "en": "Yes. My name is John Smith.", "ko": "네. 제 이름은 존 스미스입니다."}, {"i": 4, "s": 20.26, "e": 23.72, "en": "The reservation is for 7:00 PM.", "ko": "저녁 7시로 예약했습니다."}, {"i": 5, "s": 24.15, "e": 25.52, "en": "Yes, Mr. Smith.", "ko": "네, 스미스 씨."}, {"i": 6, "s": 25.52, "e": 29.22, "en": "A table for one at 7:00 PM is ready.", "ko": "7시 1인석 준비 완료되었습니다."}, {"i": 7, "s": 29.22, "e": 30.63, "en": "Please follow me.", "ko": "안내해 드리겠습니다."}, {"i": 8, "s": 31.46, "e": 32.68, "en": "Thank you.", "ko": "감사합니다. 안녕하세요"}, {"i": 9, "s": 38.24, "e": 39.2, "en": "Good evening.", "ko": "."}, {"i": 10, "s": 39.2, "e": 40.68, "en": "My name is Anna.", "ko": "제 이름은 안나입니다."}, {"i": 11, "s": 40.68, "e": 43.24, "en": "Can I get you something to drink?", "ko": "음료 드릴까요?"}, {"i": 12, "s": 43.24, "e": 44.75, "en": "Good evening, Anna.", "ko": "안녕하세요, 안나 씨."}, {"i": 13, "s": 44.75, "e": 47.65, "en": "I’d like an iced coffee, please.", "ko": "아이스 커피 주세요."}, {"i": 14, "s": 48.14, "e": 50.51, "en": "Would you like milk and sugar?", "ko": "우유와 설탕 넣으시겠어요?"}, {"i": 15, "s": 50.64, "e": 53.45, "en": "Yes, milk and sugar, please.", "ko": "네, 우유와 설탕 넣어주세요."}, {"i": 16, "s": 53.45, "e": 54.22, "en": "Okay.", "ko": "네."}, {"i": 17, "s": 54.22, "e": 56.46, "en": "I’ll be back soon with your drink.", "ko": "잠시 후에 음료를 가져다 드리겠습니다."}, {"i": 18, "s": 56.46, "e": 58.77, "en": "Here is the menu.", "ko": "메뉴판입니다. 감사"}, {"i": 19, "s": 58.77, "e": 60.05, "en": "Thank you.", "ko": "합니다."}, {"i": 20, "s": 66.77, "e": 69.84, "en": "Here is your iced coffee.", "ko": "아이스 커피 나왔습니다."}, {"i": 21, "s": 69.84, "e": 73.1, "en": "Would you like more time to look at the menu?", "ko": "메뉴를 좀 더 보시겠어요?"}, {"i": 22, "s": 73.1, "e": 75.92, "en": "Thank you. I’m ready to order now.", "ko": "감사합니다. 이제 주문할게요."}, {"i": 23, "s": 75.92, "e": 78.48, "en": "What would you like to order?", "ko": "무엇을 주문하시겠습니까?"}, {"i": 24, "s": 78.48, "e": 81.61, "en": "I’ll have a Caesar salad to start.", "ko": "시저 샐러드로 시작할게요."}, {"i": 25, "s": 81.61, "e": 84.56, "en": "A Caesar salad is a good choice.", "ko": "시저 샐러드 좋은 선택입니다."}, {"i": 26, "s": 84.56, "e": 87.5, "en": "What would you like for your main course?", "ko": "메인 요리는 무엇을 드시겠어요?"}, {"i": 27, "s": 87.5, "e": 90.64, "en": "I’ll have the Red Prawn Pasta.", "ko": "레드 프라운 파스타로 하겠습니다."}, {"i": 28, "s": 90.64, "e": 94.22, "en": "Would you like it spicy or mild?", "ko": "매콤하게 드릴까요, 아니면 순하게 드릴까요?"}, {"i": 29, "s": 94.22, "e": 96.27, "en": "Mild, please.", "ko": "순하게"}, {"i": 30, "s": 96.27, "e": 97.87, "en": "All right.", "ko": "주세요."}, {"i": 31, "s": 98.75, "e": 103.23, "en": "Here is your Caesar salad and red prawn pasta.", "ko": "네. 시저 샐러드와 레드 프라운 파스타 나왔습니다."}, {"i": 32, "s": 103.23, "e": 104.51, "en": "Please enjoy.", "ko": "맛있게 드세요."}, {"i": 33, "s": 104.51, "e": 106.11, "en": "Thank you.", "ko": "감사합니다."}, {"i": 34, "s": 106.11, "e": 108.54, "en": "Wow, the salad is fresh.", "ko": "와, 샐러드가 정말 신선하네요."}, {"i": 35, "s": 108.54, "e": 111.3, "en": "The pasta is delicious.", "ko": "파스타도 맛있어요."}, {"i": 36, "s": 111.55, "e": 114.17, "en": "Do you need anything else?", "ko": "더 필요한 거 있으세요?"}, {"i": 37, "s": 114.17, "e": 116.73, "en": "No, thank you. I’m fine.", "ko": "아니요, 괜찮습니다."}, {"i": 38, "s": 116.73, "e": 118.53, "en": "Would you like dessert now?", "ko": "디저트 드시겠어요?"}, {"i": 39, "s": 118.53, "e": 121.15, "en": "We have apple tart today.", "ko": "오늘은 애플 타르트가 있어요."}, {"i": 40, "s": 121.15, "e": 124.16, "en": "Yes, I’d like the apple tart, please.", "ko": "네, 애플 타르트 주세요. 애플 타르트"}, {"i": 41, "s": 125.12, "e": 127.42, "en": "Here is your apple tart.", "ko": "입니다."}, {"i": 42, "s": 127.42, "e": 128.77, "en": "Thank you.", "ko": "감사합니다."}, {"i": 43, "s": 128.77, "e": 131.9, "en": "Wow, the apple tart is really good.", "ko": "와, 애플 타르트 정말 맛있네요."}, {"i": 44, "s": 138.75, "e": 139.71, "en": "Excuse me.", "ko": "실례 지만,"}, {"i": 45, "s": 139.71, "e": 141.31, "en": "May I have the bill, please?", "ko": "계산서 주시겠어요?"}, {"i": 46, "s": 141.31, "e": 142.97, "en": "I’d like to pay now.", "ko": "지금 계산하고 싶습니다. 네,"}, {"i": 47, "s": 142.97, "e": 144.0, "en": "Of course.", "ko": "물론입니다."}, {"i": 48, "s": 144.0, "e": 147.45, "en": "Will you pay by card or cash?", "ko": "카드로 계산하시겠어요, 현금으로 계산하시겠어요?"}, {"i": 49, "s": 147.46, "e": 149.76, "en": "I’ll pay by card, please.", "ko": "카드로 계산할게요. 감사합니다"}, {"i": 50, "s": 151.23, "e": 152.0, "en": "Thank you.", "ko": "."}, {"i": 51, "s": 152.0, "e": 154.88, "en": "The food and service were excellent.", "ko": "음식도 서비스도 훌륭했습니다."}, {"i": 52, "s": 154.88, "e": 156.35, "en": "Thank you very much.", "ko": "정말 감사합니다."}, {"i": 53, "s": 156.35, "e": 158.14, "en": "Have a good evening.", "ko": "좋은 저녁 보내세요."}, {"i": 54, "s": 158.14, "e": 160.0, "en": "Thank you. Goodbye.", "ko": "감사합니다. 안녕히 가세요."}]}