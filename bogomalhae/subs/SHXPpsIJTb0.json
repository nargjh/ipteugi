{"ko_src": "claude", "id": "SHXPpsIJTb0", "title": "Asking for and giving directions: Easy English Conversations 💬 Episode 5", "channel": "BBC Learning English", "duration": 237, "auto": false, "lines": [{"i": 0, "s": 2.48, "e": 4.8, "en": "Easy English Conversations.", "ko": "쉬운 영어 회화"}, {"i": 1, "s": 6.72, "e": 9.04, "en": "Where is the train station?", "ko": "기차역이 어디예요?"}, {"i": 2, "s": 9.16, "e": 10.48, "en": "Hello, Sian!", "ko": "안녕, 시안!"}, {"i": 3, "s": 10.6, "e": 11.6, "en": "Hi!", "ko": "안녕!"}, {"i": 4, "s": 12.84, "e": 14.12, "en": "Where are you?", "ko": "어디야?"}, {"i": 5, "s": 14.24, "e": 15.72, "en": "I'm in Oxford.", "ko": "옥스퍼드야"}, {"i": 6, "s": 15.84, "e": 17.4, "en": "I'm from Oxford!", "ko": "나 옥스퍼드 출신이야!"}, {"i": 7, "s": 17.52, "e": 19.96, "en": "I know, but I'm lost.", "ko": "알아, 근데 길을 잃었어"}, {"i": 8, "s": 20.08, "e": 21.84, "en": "Where is the train station?", "ko": "기차역이 어디야?"}, {"i": 9, "s": 23.24, "e": 25.32, "en": "Go straight.", "ko": "쭉 가"}, {"i": 10, "s": 25.44, "e": 27.08, "en": "Go straight.", "ko": "쭉 가"}, {"i": 11, "s": 30.12, "e": 33.6, "en": "Go past the school,", "ko": "학교를 지나서"}, {"i": 12, "s": 33.72, "e": 35.84, "en": "Go past the school,", "ko": "학교를 지나서"}, {"i": 13, "s": 38.12, "e": 40.96, "en": "and turn left.", "ko": "왼쪽으로 돌아"}, {"i": 14, "s": 41.08, "e": 43.32, "en": "Turn left.", "ko": "왼쪽으로 돌아"}, {"i": 15, "s": 44.88, "e": 48.2, "en": "Oh - no, no, no! Sorry. Turn right.", "ko": "아, 아니, 아니! 미안. 오른쪽으로 돌아"}, {"i": 16, "s": 48.84, "e": 50.48, "en": "Turn right.", "ko": "오른쪽으로 돌아"}, {"i": 17, "s": 50.6, "e": 53.44, "en": "It's next to the pub.", "ko": "술집 옆에 있어"}, {"i": 18, "s": 53.56, "e": 56.2, "en": "It's next to the pub.", "ko": "술집 옆에 있어"}, {"i": 19, "s": 56.32, "e": 57.96, "en": "Aha! Thank you.", "ko": "아하! 고마워"}, {"i": 20, "s": 58.08, "e": 59.08, "en": "You're welcome.", "ko": "천만에"}, {"i": 21, "s": 61.32, "e": 62.84, "en": "Hey, Georgie!", "ko": "안녕, 조지!"}, {"i": 22, "s": 62.96, "e": 65.2, "en": "Hello! Where are you?"