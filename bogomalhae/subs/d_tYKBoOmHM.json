{"ko_src": "claude", "id": "d_tYKBoOmHM", "title": "English for most common airport customs questions", "channel": "Ross IELTS Academy", "duration": 80, "auto": true, "lines": [{"i": 0, "s": 0.55, "e": 1.51, "en": "Hello, madam.", "ko": "안녕하세요, 손님."}, {"i": 1, "s": 1.63, "e": 2.21, "en": "Hi.", "ko": "안녕하세요."}, {"i": 2, "s": 2.51, "e": 3.52, "en": "Can I see your passport,", "ko": "여권 좀"}, {"i": 3, "s": 3.47, "e": 4.97, "en": "please? Passport,", "ko": "보여 주시겠어요? 여권이요,"}, {"i": 4, "s": 5.11, "e": 5.75, "en": "yes.", "ko": "네."}, {"i": 5, "s": 9.43, "e": 10.92, "en": "I'm going to ask you some questions.", "ko": "몇 가지 질문할게요."}, {"i": 6, "s": 10.87, "e": 12.37, "en": "Is that okay? Okay.", "ko": "괜찮으시죠? 네."}, {"i": 7, "s": 13.07, "e": 14.39, "en": "Are you traveling alone?", "ko": "혼자 여행하세요?"}, {"i": 8, "s": 14.43, "e": 16.03, "en": "Yes, I'm alone.", "ko": "네, 혼자예요."}, {"i": 9, "s": 16.67, "e": 18.69, "en": "Is it your first time in Canada?", "ko": "캐나다는 처음이세요?"}, {"i": 10, "s": 18.87, "e": 20.84, "en": "Mhm. I mean, have you ever visited", "ko": "음. 그러니까, 전에 캐나다에"}, {"i": 11, "s": 20.79, "e": 22.05, "en": "Canada before?", "ko": "와 보신 적 있나요?"}, {"i": 12, "s": 22.27, "e": 23.61, "en": "No, first time.", "ko": "아니요, 처음이에요."}, {"i": 13, "s": 23.91, "e": 25.04, "en": "And are you traveling", "ko": "그럼 여행 목적이"}, {"i": 14, "s": 24.99, "e": 28.03, "en": "for work, study, or leisure?", "ko": "일, 공부, 여가 중 뭐예요?"}, {"i": 15, "s": 28.55, "e": 30.21, "en": "I don't understand.", "ko": "무슨 말인지 모르겠어요."}, {"i": 16, "s": 30.31, "e": 31.88, "en": "I mean, are you here to do any", "ko": "그러니까, 이런 것 중에"}, {"i": 17, "s": 31.83, "e": 33.4, "en": "of these things? Studying,", "ko": "하러 오셨나요? 공부,"}, {"i": 18, "s": 33.35, "e": 34.23, "en": "working,", "ko": "일,"}, {"i": 19, "s": 34.27, "e": 35.56, "en": "or for fun time,", "ko": "아니면 재미로,"}, {"i": 20, "s": 35.51, "e": 37.87, "en": "leisure time? Oh, to see my brother.", "ko": "쉬러 오셨나요? 아, 오빠 보러요."}, {"i": 21, "s": 38.19, "e": 39.33, "en": "Leisure, then.", "ko": "그럼 여가네요."}, {"i": 22, "s": 39.63, "e": 41.12, "en": "And where will you be staying?", "ko": "어디에서 지내실 거예요?"}, {"i": 23, "s": 41.07, "e": 43.29, "en": "In a hotel or someone's home?", "ko": "호텔이요, 아니면 누구 집이요?"}, {"i": 24, "s": 43.47, "e": 45.2, "en": "Uh my brother's house.", "ko": "음, 오빠 집이요."}, {"i": 25, "s": 45.15, "e": 47.64, "en": "Right. And what is the duration", "ko": "네. 그럼 머무는 기간은"}, {"i": 26, "s": 47.59, "e": 48.57, "en": "of your stay?", "ko": "얼마나 되나요?"}, {"i": 27, "s": 48.79, "e": 49.79, "en": "2 weeks.", "ko": "2주요."}, {"i": 28, "s": 50.11, "e": 52.72, "en": "2 weeks, right. And do you have medical", "ko": "2주요, 알겠습니다. 의료"}, {"i": 29, "s": 52.67, "e": 53.67, "en": "insurance?", "ko": "보험은 있으세요?"}, {"i": 30, "s": 54.03, "e": 55.95, "en": "Uh yes, I have insurance.", "ko": "네, 보험 있어요."}, {"i": 31, "s": 56.11, "e": 57.45, "en": "Great. So,", "ko": "좋아요. 그럼"}, {"i": 32, "s": 58.03, "e": 59.25, "en": "welcome to Canada.", "ko": "캐나다에 오신 걸 환영합니다."}, {"i": 33, "s": 59.27, "e": 60.49, "en": "Thank you very much.", "ko": "정말 감사합니다."}, {"i": 34, "s": 62.18, "e": 63.0, "en": "[music]", "ko": "(음악)"}, {"i": 35, "s": 68.73, "e": 69.55, "en": "[music]", "ko": "(음악)"}, {"i": 36, "s": 77.89, "e": 78.71, "en": "[music]", "ko": "(음악)"}]}