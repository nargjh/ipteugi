{"id": "gr75FmbDJlI", "title": "Hotel English | Checking Into a Hotel & Room Service | Travel English Conversation Practice", "channel": "English Together", "duration": 162, "auto": false, "lines": [{"i": 0, "s": 11.63, "e": 14.2, "en": "Good afternoon. Welcome to Sunny Hotel.", "ko": "안녕하세요. 써니 호텔에 오신 것을 환영합니다."}, {"i": 1, "s": 14.2, "e": 16.24, "en": "How can I help you?", "ko": "무엇을 도와드릴까요?"}, {"i": 2, "s": 16.24, "e": 19.72, "en": "Good afternoon. I have a reservation.", "ko": "안녕하세요. 예약했습니다."}, {"i": 3, "s": 19.96, "e": 22.46, "en": "May I have your name, please?", "ko": "성함을 알려주시겠어요?"}, {"i": 4, "s": 22.54, "e": 25.29, "en": "My name is Jessica Smith.", "ko": "제 이름은 제시카 스미스입니다."}, {"i": 5, "s": 25.8, "e": 27.46, "en": "Thank you, Ms. Smith.", "ko": "감사합니다, 스미스 씨."}, {"i": 6, "s": 27.46, "e": 29.38, "en": "Let me check.", "ko": "확인해 보겠습니다."}, {"i": 7, "s": 29.64, "e": 32.27, "en": "Yes, I see your reservation here.", "ko": "네, 예약 내역이 있습니다."}, {"i": 8, "s": 32.27, "e": 33.29, "en": "Great.", "ko": "좋습니다."}, {"i": 9, "s": 33.93, "e": 36.81, "en": "You booked one single room for two nights.", "ko": "싱글룸 1박을 예약하셨죠"}, {"i": 10, "s": 36.81, "e": 38.22, "en": "Is that right?", "ko": "?"}, {"i": 11, "s": 38.22, "e": 40.01, "en": "Yes, that’s right.", "ko": "네, 맞습니다."}, {"i": 12, "s": 40.52, "e": 43.15, "en": "May I see your passport, please?", "ko": "여권을 보여주시겠어요?"}, {"i": 13, "s": 44.55, "e": 45.9, "en": "Here you are.", "ko": "여기 있습니다."}, {"i": 14, "s": 45.98, "e": 47.39, "en": "Thank you.", "ko": "감사합니다."}, {"i": 15, "s": 48.03, "e": 51.1, "en": "Your room number is 705.", "ko": "객실 번호는 705호입니다"}, {"i": 16, "s": 51.1, "e": 53.92, "en": "It is on the seventh floor.", "ko": ". 7층에 있습니다."}, {"i": 17, "s": 53.92, "e": 56.16, "en": "Here is your room key.", "ko": "객실 키입니다."}, {"i": 18, "s": 56.41, "e": 57.5, "en": "Great.", "ko": "좋습니다."}, {"i": 19, "s": 57.5, "e": 59.94, "en": "What time is check-out?", "ko": "체크아웃 시간은 몇 시인가요?"}, {"i": 20, "s": 60.32, "e": 63.71, "en": "Check-out is at eleven o’clock in the morning.", "ko": "체크아웃은 오전 11시입니다."}, {"i": 21, "s": 63.71, "e": 67.28, "en": "Okay. Is breakfast included?", "ko": "네. 조식이 포함되어 있나요?"}, {"i": 22, "s": 67.28, "e": 69.66, "en": "Yes, breakfast is included.", "ko": "네, 조식은 포함되어 있습니다."}, {"i": 23, "s": 69.66, "e": 73.38, "en": "It is served from seven to ten in the restaurant.", "ko": "레스토랑에서 오전 7시부터 10시까지 제공됩니다."}, {"i": 24, "s": 73.44, "e": 75.74, "en": "Where is the restaurant?", "ko": "레스토랑은 어디에 있나요?"}, {"i": 25, "s": 75.74, "e": 78.11, "en": "It is on the first floor.", "ko": "1층에 있습니다."}, {"i": 26, "s": 78.36, "e": 80.21, "en": "Thank you.", "ko": "감사합니다."}, {"i": 27, "s": 80.22, "e": 83.73, "en": "Does the hotel offer free Wi-Fi?", "ko": "호텔에서 무료 Wi-Fi를 제공하나요?"}, {"i": 28, "s": 83.73, "e": 85.27, "en": "Yes, we do.", "ko": "네, 제공합니다."}, {"i": 29, "s": 85.27, "e": 89.17, "en": "The Wi-Fi network name is \"Sunny Hotel Guest\".", "ko": "Wi-Fi 네트워크 이름은 \"Sunny Hotel Guest\"이고"}, {"i": 30, "s": 89.17, "e": 93.33, "en": "The password is \"welcome123\".", "ko": "비밀번호는 \"welcome123\"입니다."}, {"i": 31, "s": 93.33, "e": 95.25, "en": "Thank you.", "ko": "감사합니다."}, {"i": 32, "s": 95.25, "e": 97.24, "en": "Have a nice day, Ms. Smith.", "ko": "좋은 하루 보내세요, 스미스 씨."}, {"i": 33, "s": 97.24, "e": 99.93, "en": "Thank you. You too.", "ko": "감사합니다. 저도요."}, {"i": 34, "s": 106.9, "e": 109.21, "en": "Hi, how can I help you?", "ko": "안녕하세요, 무엇을 도와드릴까요?"}, {"i": 35, "s": 109.21, "e": 112.85, "en": "Hi, I would like to order room service.", "ko": "안녕하세요, 룸서비스를 주문하고 싶습니다."}, {"i": 36, "s": 112.86, "e": 114.26, "en": "Of course, madam.", "ko": "네, 물론입니다."}, {"i": 37, "s": 114.26, "e": 116.44, "en": "What would you like to order?", "ko": "무엇을 주문하시겠습니까?"}, {"i": 38, "s": 116.44, "e": 120.79, "en": "I’d like a burger, fries, and a Coke, please.", "ko": "햄버거, 감자튀김, 콜라 주세요."}, {"i": 39, "s": 120.79, "e": 122.77, "en": "Absolutely, madam.", "ko": "네, 알겠습니다."}, {"i": 40, "s": 122.78, "e": 126.81, "en": "Your order will be delivered to your room in about 30 minutes.", "ko": "주문하신 음식은 약 30분 후에 객실로 배달됩니다."}, {"i": 41, "s": 129.28, "e": 132.09, "en": "Thank you for your order, madam.", "ko": "주문해 주셔서 감사합니다."}, {"i": 42, "s": 132.09, "e": 133.89, "en": "Thank you.", "ko": "감사합니다."}, {"i": 43, "s": 133.89, "e": 135.61, "en": "You’re welcome, madam.", "ko": "천만에요."}, {"i": 44, "s": 135.61, "e": 137.34, "en": "Enjoy your meal.", "ko": "맛있게 드세요."}]}